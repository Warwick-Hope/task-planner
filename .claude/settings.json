{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "fresh",
    "symlinkDirectories": ["node_modules"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-check.mjs",
            "timeout": 20,
            "statusMessage": "Checking for other sessions..."
          }
        ]
      }
    ]
  }
}
