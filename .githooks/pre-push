#!/bin/sh
#
# Two guards, in order:
#   1. the pushing GitHub account is the one this repo is pinned to
#   2. no push to main
#
# Installed by `npm run setup:hooks`, which sets core.hooksPath to .githooks.
# Git will not run a hook nobody opted into, so a fresh clone needs that once.

# ── 1. GitHub account ─────────────────────────────────────────────────────────
#
# There are two GitHub accounts on this machine (personal Warwick-Hope, and a
# secondary WarwickHope), and `gh auth switch` changes the active one GLOBALLY.
# Work on a business repo and the active account follows you back here, so the
# next push to this repo 403s with nothing to explain why.
#
# The fix is credential.https://github.com.username, set per repo: git passes it
# to `gh auth git-credential` as a hint, and gh returns that account's token
# regardless of which one is globally active. This check makes sure the pin is
# actually in place and points at an account gh is logged into — a clear failure
# here beats a bare 403 from the remote.

pinned=$(git config --get credential.https://github.com.username)

if [ -z "$pinned" ]; then
	cat >&2 <<-'EOF'

		✗ pre-push: this repo is not pinned to a GitHub account.

		  Without a pin, git uses whichever account `gh` has active globally —
		  which changes whenever you work on a repo belonging to the other one.

		    npm run setup:hooks     # sets the pin along with the hooks path

		  Or directly:

		    git config --local credential.https://github.com.username Warwick-Hope

	EOF
	exit 1
fi

if command -v gh >/dev/null 2>&1; then
	if ! gh auth status --hostname github.com 2>&1 | grep -q "account ${pinned} "; then
		cat >&2 <<-EOF

			✗ pre-push: this repo is pinned to the GitHub account "${pinned}",
			  but gh is not logged in as that account.

			    gh auth login --hostname github.com

			  Then re-run the push. You do NOT need to switch the active account —
			  the pin selects the right one on its own.

		EOF
		exit 1
	fi
fi

# ── 2. No push to main ────────────────────────────────────────────────────────
#
# A push to main is a production deploy — Vercel publishes
# https://task-planner-nine-sigma.vercel.app on every push. The repo is
# private on a free personal plan, so server-side branch protection is
# unavailable; this hook is the substitute.
#
# Emergency override, for a revert that should not wait for a PR round-trip:
#   TP_ALLOW_MAIN_PUSH=1 git push origin main
#
# stdin gives one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>

if [ "$TP_ALLOW_MAIN_PUSH" = "1" ]; then
	echo "pre-push: TP_ALLOW_MAIN_PUSH=1 — allowing a push to main. Say why in the commit message."
	exit 0
fi

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		cat >&2 <<-'EOF'

			✗ pre-push: refusing to push to main.

			  A push to main deploys to production immediately. Work on a branch
			  and merge through a pull request:

			    git switch -c <type>/<slug> origin/main
			    git push -u origin <type>/<slug>
			    gh pr create --fill
			    gh pr merge --squash

			  See CLAUDE.md § Git workflow. If this really is an emergency revert:

			    TP_ALLOW_MAIN_PUSH=1 git push origin main

		EOF
		exit 1
	fi
done

exit 0
